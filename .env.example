# NewsGuard AI Environment Configuration

# SQLite local database URL (default is sqlite:///./newsguard.db)
DATABASE_URL=sqlite:///./newsguard.db

# --- Gemini API Config ---
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# --- OpenAI API Config (Optional) ---
# If you prefer using OpenAI models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Note: If no API keys are provided, NewsGuard AI runs automatically in DEMO MODE.
# Pre-computed high-fidelity scenarios will be served for demo inputs, and local rule-based
# fallbacks will process custom text entries.
